# Google OAuth Credentials (for Gmail integration)
# Create these in Google Cloud Console; never commit real values.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=generate_a_secret_here_e_g_using_openssl

# Optional: comma-separated list of Google accounts allowed to sign in.
# If unset, any Google account that completes OAuth can access the app.
ALLOWED_EMAILS=
